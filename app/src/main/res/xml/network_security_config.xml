<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Require TLS for every app connection and trust only the Android system CA store. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
